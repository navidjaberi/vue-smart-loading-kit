{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "env.d.ts"
  ]
}
