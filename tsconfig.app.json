{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "jsx": "preserve",

    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "declaration": true,
    "declarationDir": "./dist",

    "types": [
      "vitest/globals"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "shims-vue.d.ts"
  ]
}