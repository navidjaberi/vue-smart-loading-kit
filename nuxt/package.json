{
  "name": "nuxt-smart-loading-kit",
  "version": "0.1.0",
  "description": "Nuxt module for vue-smart-loading-kit: turn real components into their own skeleton with v-skeleton, plus spinners, progress bars and a route progress bar. SSR-safe, auto-imported.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "prepublishOnly": "npm run dev:prepare && npm run test:types && npm test"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt3",
    "nuxt4",
    "vue",
    "vue3",
    "skeleton",
    "skeleton-loader",
    "spinner",
    "loading",
    "loader",
    "progress-bar",
    "page-progress",
    "ssr"
  ],
  "author": "Navid Jaberi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidjaberi/vue-smart-loading-kit.git",
    "directory": "nuxt"
  },
  "bugs": {
    "url": "https://github.com/navidjaberi/vue-smart-loading-kit/issues"
  },
  "homepage": "https://github.com/navidjaberi/vue-smart-loading-kit/tree/main/nuxt#readme",
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "defu": "^6.1.7",
    "vue-smart-loading-kit": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.19.0",
    "nuxt": "^4.6.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
